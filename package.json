{
  "name": "sry-research-atlas",
  "version": "4.8.0",
  "type": "module",
  "description": "Bohr Research Atlas (玻尔科学空间): bilateral knowledge graph, multi-source scholarly retrieval (OpenAlex, Crossref, Europe PMC, arXiv), bilingual summaries, interactive mind maps, open-access PDF proxy, and native DSH conversation integration.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "knowledge-graph",
    "literature-review",
    "materials-science",
    "chemistry",
    "open-access",
    "paper-search",
    "mind-map"
  ],
  "author": "ssstry2635",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssstry2635/sry-research-atlas.git"
  },
  "homepage": "https://github.com/ssstry2635/sry-research-atlas#readme",
  "bugs": {
    "url": "https://github.com/ssstry2635/sry-research-atlas/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
